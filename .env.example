# Copy this file to `.env` and fill with your real keys.
# Then run with: docker run --env-file .env ...

# Required: get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: get yours at https://app.tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: any model available on OpenRouter (default: openai/gpt-4o-mini)
# See full list at https://openrouter.ai/models
MODEL=openai/gpt-4o-mini
